<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time test of the plugin's telemetry, which uses no game type, so it
       runs without the game's assemblies; never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../src/Telemetry/*.cs" />
  </ItemGroup>

</Project>
